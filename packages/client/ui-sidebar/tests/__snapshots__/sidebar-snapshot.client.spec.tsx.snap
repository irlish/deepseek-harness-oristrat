// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows collapsed 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root collapsed railIn quietBars"
    style=""
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="Open sidebar"
        class="iconButton toggle"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="88020f34"
          fill="none"
          height="16"
          stroke-width="1"
          viewBox="0 0 16 16"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        />
        <div
          data-slot="sidebar.toggle.badge"
          style="display: contents;"
        />
      </button>
    </div>
    <button
      aria-label="New session"
      class="newSession"
      type="button"
    >
      <span
        class="newSessionLabelMask"
      >
        <span
          class="newSessionContent"
        >
          <svg
            aria-hidden="true"
            data-content="47b5e433"
            fill="none"
            height="16"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="16"
            xmlns="http://www.w3.org/2000/svg"
          />
        </span>
      </span>
    </button>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows expanded 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
    style="width: 300px;"
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="New session"
        class="brand wide"
        type="button"
      >
        <span
          aria-hidden="true"
          class="brandIdentity"
        >
          <span
            class="brandMark"
          >
            <div
              data-slot="sidebar.brand.mark"
              style="display: contents;"
            >
              <img
                alt=""
                aria-hidden="true"
                height="23.4375"
                src="data:image/png;base64,"
                width="24"
              />
            </div>
          </span>
          <span
            class="brandName"
          >
            <div
              data-slot="sidebar.brand.name"
              style="display: contents;"
            >
              <span
                aria-label="Oristrat AI STEM"
                style="display: inline-flex; align-items: center; gap: 6px;"
              >
                <span
                  style="font-size: 16px; font-weight: 600; letter-spacing: 0.02em; line-height: 1; white-space: nowrap;"
                >
                  Oristrat AI
                </span>
                <span
                  aria-hidden="true"
                  style="display: inline-flex; align-items: center; background: var(--dsw-alias-label-primary); color: var(--dsw-alias-label-primary-inverted); border-radius: 3px; padding: 2px 5px; font-size: 10px; font-weight: 700; letter-spacing: 0.05em; line-height: 1; white-space: nowrap;"
                >
                  STEM
                </span>
              </span>
            </div>
          </span>
        </span>
      </button>
      <button
        aria-label="Collapse sidebar"
        class="iconButton toggle"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="88020f34"
          fill="none"
          height="16"
          stroke-width="1"
          viewBox="0 0 16 16"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        />
      </button>
    </div>
    <div
      class="modeRow"
    >
      <span
        class="root"
      >
        <button
          aria-expanded="false"
          aria-haspopup="menu"
          aria-label="Work mode"
          class="modeChip wide"
          type="button"
        >
          <svg
            aria-hidden="true"
            data-content="9af0dd6b"
            fill="none"
            height="14"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          />
          <span
            class="modeChipName"
          >
            Coding
          </span>
          <svg
            aria-hidden="true"
            class="modeChipChevron"
            data-content="2b5d7fd1"
            fill="none"
            height="14"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          />
        </button>
      </span>
    </div>
    <button
      aria-label="New session"
      class="newSession"
      type="button"
    >
      <span
        class="newSessionLabelMask"
      >
        <span
          class="newSessionContent"
        >
          <svg
            aria-hidden="true"
            data-content="47b5e433"
            fill="none"
            height="14"
            stroke-width="1.3"
            viewBox="0 0 16 16"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          />
          <span
            class="newSessionLabel wide"
          >
            New Session
          </span>
        </span>
      </span>
    </button>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

